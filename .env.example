# OpenRouter API 키 (https://openrouter.ai/settings/keys 에서 발급)
# 이 파일을 복사해 .env 로 만들고 키를 넣으세요. .env 는 git에 올라가지 않습니다.
OPENROUTER_API_KEY=

# 사용할 모델 (https://openrouter.ai/models 의 모델 이름을 그대로 입력)
# 예: anthropic/claude-sonnet-5, anthropic/claude-haiku-4.5, openai/gpt-6-sol, google/gemini-3.8-flash
AI_MODEL=anthropic/claude-sonnet-5

# 서버 포트 (선택, 기본값 8820)
PORT=8820
